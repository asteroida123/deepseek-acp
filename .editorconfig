root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Markdown 里行尾两个空格是硬换行，裁掉会改变渲染结果。
trim_trailing_whitespace = false

[*.drawio]
# draw.io 自己生成的 XML，不要动它的缩进。
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false
insert_final_newline = unset
